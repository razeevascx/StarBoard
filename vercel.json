{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "startpage": {
      "root": "apps/startpage",
      "framework": "vite",
      "outputDirectory": "dist"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
