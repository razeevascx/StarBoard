# Public origin for canonical URLs, social previews, robots.txt, and sitemap.xml.
# Set this to your deployed web app URL (include https://, omit a trailing path).
SITE_URL=https://starboard.razeev.com
# Clerk (required — every route, including /mcp, 500s without these).
# Get them from https://dashboard.clerk.com/~/api-keys or `npx clerk@latest env pull`.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Override to http://localhost:3000/mcp for local dev.
MCP_RESOURCE_URL=https://mcp.starboard.razeev.com/mcp
