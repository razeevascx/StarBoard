# Release builds use the deployed dashboard. Use http://localhost:3000 for a local web server.
VITE_WEB_URL=https://starboard.razeev.com
# Optional in this monorepo: falls back to apps/web's NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY.
VITE_CLERK_PUBLISHABLE_KEY=
# Chrome only: a public key for a stable extension ID across builds.
VITE_EXTENSION_PUBLIC_KEY=
